---
import type { SiteData } from '../data/site';
interface Props { data: SiteData['qualifications'] }
const { data } = Astro.props;
---
<section id="qualifications" class="section qualifications" aria-labelledby="qualifications-heading">
  <div class="container">
    <div class="qualifications__intro">
      <div><p class="eyebrow">{data.eyebrow}</p><h2 id="qualifications-heading" class="section-heading">{data.heading}</h2></div>
      <p class="body-copy">{data.description}</p>
    </div>
    <div class="qualifications__grid">
      {data.items.map((item) => (
        <article class="qualifications__card">
          <div class="qualifications__document" aria-hidden="true"><span></span><span></span><span></span><i></i></div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style lang="scss">
  .qualifications {
    border-top: 1px solid var(--color-border);
    &__intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 3rem; margin-bottom: 3rem; }
    &__intro .body-copy { margin: 0; }
    &__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
    &__card { min-width: 0; }
    &__document { position: relative; width: 76px; height: 94px; padding: 20px 14px; margin-bottom: 2rem; background: var(--color-hero); border: 1px solid var(--color-border); border-radius: 4px; }
    &__document span { display: block; height: 1px; background: var(--color-accent); opacity: 0.4; margin-bottom: 8px; }
    &__document span:nth-child(2) { width: 70%; }
    &__document i { position: absolute; bottom: 10px; right: 10px; width: 18px; height: 18px; border-radius: 50%; border: 1px solid var(--color-accent); }
    h3 { font-size: 1.375rem; }
    &__card p { margin-bottom: 0; color: var(--color-muted); }
    @media(max-width: 767.98px) {
      &__intro, &__grid { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
      &__intro { margin-bottom: 2.5rem; }
      &__card { border-top: 1px solid var(--color-border); padding-top: 1.5rem; }
      &__document { margin-bottom: 1.5rem; }
    }
  }
</style>
