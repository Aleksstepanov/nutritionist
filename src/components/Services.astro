---
import type { SiteData } from '../data/site';
interface Props { data: SiteData['services'] }
const { data } = Astro.props;
---
<section id="services" class="section services" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2 id="services-heading" class="section-heading">{data.heading}</h2>
      <p class="body-copy">{data.description}</p>
    </div>
    <div class="services__grid">
      {data.items.map((item) => (
        <article class:list={['services__card', { 'services__card--mint': item.tone === 'mint' }]}>
          <div class="services__card-top"><span>{item.number}</span><span class="services__decoration" aria-hidden="true"></span></div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>
          <a class="services__link" href="#contacts">{data.ctaLabel}<span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
<style lang="scss">
  .services {
    &__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
    &__card { display: flex; flex-direction: column; padding: clamp(1.5rem, 3vw, 2.75rem); border: 1px solid var(--color-border); border-radius: 8px; }
    &__card--mint { background: var(--color-hero); border-color: var(--color-hero); }
    &__card-top { display: flex; justify-content: space-between; align-items: center; color: var(--color-muted); margin-bottom: 2.5rem; }
    &__decoration { display: block; width: 38px; height: 38px; border: 1px solid var(--color-accent); border-radius: 50% 0 50% 0; transform: rotate(-15deg); }
    h3 { color: var(--color-accent); font-size: clamp(1.5rem, 1.1rem + 1vw, 2rem); }
    p { color: var(--color-muted); max-width: 29rem; }
    ul { list-style: none; padding: 0; margin: 0.5rem 0 2rem; }
    li { display: flex; gap: 0.75rem; margin-bottom: 0.5rem; }
    li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--color-accent); flex-shrink: 0; margin-top: 0.65em; }
    &__link { margin-top: auto; padding-block: 0.75rem; min-height: 44px; border-top: 1px solid var(--color-border); display: flex; align-items: center; justify-content: space-between; gap: 1rem; text-decoration: none; }
    &__link span { font-size: 1.5rem; }
    @media(max-width: 767.98px) { &__grid { grid-template-columns: minmax(0, 1fr); gap: 1rem; } &__card-top { margin-bottom: 1.5rem; } }
  }
</style>
