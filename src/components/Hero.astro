---
import { validateHeroData, type HeroData } from '../data/hero';

interface Props {
  data: HeroData;
}

const { data: input } = Astro.props;
const data = validateHeroData(input);
const contactHref = data.cta.href.trim();
const portraitSrc = data.portrait.src.trim();
// Local public assets remain valid when GitHub Pages serves a repository subpath.
const imageSrc = portraitSrc.startsWith('/') && !portraitSrc.startsWith('//')
  ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${portraitSrc}`
  : portraitSrc;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__inner">
    <div class="hero__content">
      {(data.professionalTitle.trim() || data.specialization.trim()) && (
        <div class="hero__intro">
          {data.professionalTitle.trim() && <p class="hero__eyebrow">{data.professionalTitle}</p>}
          {data.specialization.trim() && <p class="hero__specialization">{data.specialization}</p>}
        </div>
      )}
      <h1 id="hero-heading" class="hero__heading">{data.heading}</h1>
      <p class="hero__description">{data.description}</p>
      {contactHref && <a class="hero__cta" href={contactHref}>{data.cta.label}</a>}
    </div>
    <div
      class="hero__portrait"
      style={{ '--portrait-ratio': `${data.portrait.width} / ${data.portrait.height}` }}
    >
      {portraitSrc ? (
        <img
          src={imageSrc}
          alt={data.portrait.alt}
          width={data.portrait.width}
          height={data.portrait.height}
          style={{ 'object-position': data.portrait.objectPosition }}
          fetchpriority="high"
        />
      ) : (
        <div class="hero__portrait-placeholder" aria-hidden="true">
          <span class="hero__portrait-head"></span>
          <span class="hero__portrait-shoulders"></span>
        </div>
      )}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/mixins';

  .hero {
    background: var(--color-hero);

    &__inner {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
      min-height: 721px;
      padding-block: 4.5rem;
    }

    &__content { min-width: 0; }

    &__intro {
      margin-bottom: 1.5rem;
      p:last-child { margin-bottom: 0; }
    }

    &__specialization {
      margin-bottom: 0;
      color: var(--color-accent);
      font-size: 1rem;
      line-height: 1.5;
    }

    &__eyebrow {
      margin-bottom: 0.5rem;
      color: var(--color-muted);
      font-size: 0.875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    &__heading {
      margin-bottom: 1.75rem;
      color: var(--color-accent);
      font-size: 3.625rem;
      font-weight: 500;
      line-height: 1.1552;
      letter-spacing: -0.04em;
      overflow-wrap: break-word;
    }

    &__description {
      max-width: 30rem;
      margin-bottom: 0;
      color: var(--color-text);
      font-size: 1.125rem;
      line-height: 1.75;
    }

    &__cta {
      box-shadow: var(--shadow-soft);
      transition: background-color var(--motion-fast), color var(--motion-fast), box-shadow var(--motion-base);
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-height: 52px;
      max-width: 100%;
      margin-top: 2rem;
      padding: 0.875rem 1.75rem;
      border: 1px solid var(--color-accent);
      border-radius: 4px;
      background: var(--color-accent);
      color: var(--color-surface);
      text-align: center;
      text-decoration: none;

      @include mixins.hover {
        background: var(--color-surface);
        color: var(--color-accent);
        box-shadow: var(--shadow-raised);
      }
    }

    &__portrait {
      position: relative;
      width: 100%;
      max-width: 440px;
      aspect-ratio: var(--portrait-ratio);
      justify-self: end;
      overflow: hidden;
      border-radius: 220px 220px 8px 8px;
      background: var(--color-border);
      box-shadow: var(--shadow-soft);

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    // Decorative silhouette reserves the portrait slot without inventing a person.
    &__portrait-placeholder {
      position: absolute;
      inset: 0;
      overflow: hidden;
      background: linear-gradient(145deg, var(--color-surface), var(--color-border));
    }

    &__portrait-head {
      position: absolute;
      top: 23%;
      left: 35%;
      width: 30%;
      height: 26%;
      border-radius: 50%;
      background: var(--color-accent);
      opacity: 0.14;
    }

    &__portrait-shoulders {
      position: absolute;
      bottom: -12%;
      left: 10%;
      width: 80%;
      height: 60%;
      border-radius: 50% 50% 0 0;
      background: var(--color-accent);
      opacity: 0.14;
    }

    @media (max-width: 1023.98px) {
      &__inner {
        min-height: auto;
        gap: 2rem;
        padding-block: 3.5rem;
      }

      &__heading { font-size: 2.75rem; }
    }

    @media (max-width: 767.98px) {
      &__inner {
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        padding-block: 2.5rem 3rem;
      }

      &__heading {
        font-size: clamp(2rem, 1.25rem + 4vw, 2.75rem);
        line-height: 1.2;
        letter-spacing: -0.035em;
      }

      &__eyebrow {
        margin-bottom: 1rem;
        font-size: 0.75rem;
      }

      &__description {
        max-width: none;
        font-size: 1rem;
      }

      &__portrait {
        max-width: 360px;
        justify-self: center;
      }
    }
  }
</style>
